#!/usr/bin/env bash
set -euo pipefail

# Deliberately pinned. Updating these values is a reviewed dependency update,
# not something that happens while the plugin is installed or started.
readonly WS_VERSION="17.0.1"
readonly WS_SHA256="5baa9bc0dfbae8c507e51c8cf1b6d4628086f7a87bbd3a9952bd5f035451f1cc"
readonly WS_URL="https://files.pythonhosted.org/packages/f7/96/e01084f83a64bcb3a27994bd0cb0db68ff29d9c6707fae37ec19b18ba990/websockets-17.0.1.tar.gz"

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly VENDOR_ROOT="$PROJECT_ROOT/vendor"
readonly TARGET="$VENDOR_ROOT/websockets"
readonly LICENSE_TARGET="$VENDOR_ROOT/LICENSE.websockets"
readonly METADATA="$VENDOR_ROOT/README.md"

tmp_dir="$(mktemp -d)"
trap 'rm -rf -- "$tmp_dir"' EXIT

archive="$tmp_dir/websockets-$WS_VERSION.tar.gz"
staging="$tmp_dir/staging"
mkdir -p -- "$staging"

curl --fail --location --silent --show-error "$WS_URL" --output "$archive"
printf '%s  %s\n' "$WS_SHA256" "$archive" | sha256sum --check --strict

tar -xzf "$archive" -C "$staging" --strip-components=2 \
  --exclude='*/speedups.c' \
  "websockets-$WS_VERSION/src/websockets"
tar -xOf "$archive" "websockets-$WS_VERSION/LICENSE" > "$staging/LICENSE.websockets"

if ! grep -Fq -- "$WS_VERSION" "$METADATA" \
    || ! grep -Fq -- "$WS_SHA256" "$METADATA"; then
  echo "vendor/README.md must document the pinned version and SHA-256" >&2
  exit 1
fi

if find "$staging/websockets" -type l -print -quit | grep -q .; then
  echo "refusing a dependency tree containing symbolic links" >&2
  exit 1
fi

if find "$staging/websockets" -type f \
    \( -name '*.so' -o -name '*.pyc' -o -name '*.pyo' \) -print -quit \
    | grep -q .; then
  echo "refusing binary or generated Python artifacts" >&2
  exit 1
fi

# TARGET is a fixed path below this repository's vendor directory.
rm -rf -- "$TARGET"
mv -- "$staging/websockets" "$TARGET"
mv -- "$staging/LICENSE.websockets" "$LICENSE_TARGET"
echo "vendored websockets $WS_VERSION"
